async function loadGame(){
try{
let candidates=[];
try{
const raw=localStorage.getItem(SAVE_KEY),metaRaw=localStorage.getItem(SAVE_META_KEY),d=parseStoredSave(raw);
if(d){let meta=null;try{meta=JSON.parse(metaRaw||'null')}catch(e){}candidates.push({d,meta:meta||{savedAt:0,day:d.day||1},source:'localStorage'})}
}catch(e){console.warn('Hauptspielstand beschädigt:',e)}
try{
const backup=localStorage.getItem(SAVE_BACKUP_KEY),d=parseStoredSave(backup);
if(d)candidates.push({d,meta:{savedAt:0,day:d.day||1},source:'Backup'});
}catch(e){console.warn('Backup ungültig:',e)}
const idb=await loadFromIndexedDB();
if(idb&&idb.payload){
try{
const d=parseStoredSave(idb.payload);
if(d)candidates.push({d,meta:idb.meta||{savedAt:0,day:d.day||1},source:'IndexedDB'});
}catch(e){console.warn('IndexedDB-Spielstand ungültig:',e)}
}
if(!candidates.length)return false;
candidates.sort((a,b)=>(b.meta?.savedAt||0)-(a.meta?.savedAt||0));
const chosen=candidates[0];
chosen.meta=chosen.meta||{};chosen.meta.plantedTrees=Number.isFinite(chosen.meta.plantedTrees)?chosen.meta.plantedTrees:(Array.isArray(chosen.d.trees)?chosen.d.trees.filter(t=>t.plantedDay!=null&&!t.stump).length:0);chosen.meta.activeCrops=Number.isFinite(chosen.meta.activeCrops)?chosen.meta.activeCrops:(Array.isArray(chosen.d.plots)?chosen.d.plots.filter(p=>p.crop).length:0);
applyLoadedSave(chosen.d);
try{
localStorage.setItem(SAVE_KEY,JSON.stringify(chosen.d));
localStorage.setItem(SAVE_META_KEY,JSON.stringify(chosen.meta));
}catch(e){}
updateSaveStatus(chosen.meta||{savedAt:Date.now(),day:state.day},true);
if(UI.houseSaveStatus)UI.houseSaveStatus.textContent=`✅ Geladen aus ${chosen.source}: ${formatSaveTime(chosen.meta?.savedAt||Date.now())} · Tag ${state.day}`;
return true;
}catch(e){console.error('Laden fehlgeschlagen:',e);return false}
}
