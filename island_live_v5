function randomWeather(){const r=Math.random();return r<.52?'sunny':r<.78?'cloudy':r<.95?'rain':'storm'}function newDay(fromBed=true){const missedMeal=!state.ateToday,coldNight=season()==='Winter'&&state.stoveFuel<360;state.day++;state.minutes=7*60+30;let wakeEnergy=state.maxEnergy;if(missedMeal)wakeEnergy-=35;if(coldNight)wakeEnergy-=20;state.energy=Math.max(35,wakeEnergy);state.hunger=missedMeal?42:72;state.ateToday=false;state.stoveFuel=Math.max(0,state.stoveFuel-480);refreshDailyObjects();state.weather=randomWeather();spawnBugs();if(fromBed)setOverlay('houseOverlay',false);saveGame();if(missedMeal&&coldNight)toast(`Tag ${state.day}: hungrig und in einer kalten Winternacht geschlafen – heute bist du erschöpft.`);else if(missedMeal)toast(`Tag ${state.day}: Du hast gestern nichts gegessen und startest erschöpft.`);else if(coldNight)toast(`Tag ${state.day}: Ohne warmen Ofen war die Winternacht ziemlich frisch.`);else toast(`Guten Morgen! Tag ${state.day} beginnt.`)}function eatFood(id){const nutrition={apple:40,orange:48,cherry:32,carrot:38,tomato:34,pumpkin:60};if(!nutrition[id]||(state.inventory[id]||0)<1)return;state.inventory[id]--;state.hunger=Math.min(100,state.hunger+nutrition[id]);state.energy=Math.min(state.maxEnergy,state.energy+8);state.ateToday=true;renderInventory();updateHud();saveGame(false);toast(`${ITEMS[id].icon} ${ITEMS[id].name} gegessen. Du bist satt(er).`)}function stokeStove(){if((state.inventory.wood||0)<2){toast('Für den Holzofen brauchst du 2 Holz.');return}if(state.stoveFuel>600){toast('Der Ofen ist bereits gut befüllt.');return}state.inventory.wood-=2;state.stoveFuel=Math.min(720,state.stoveFuel+480);renderHouse();saveGame(false);toast('🔥 2 Holz nachgelegt – der Ofen brennt etwa 8 Spielstunden.')}
function refreshDailyObjects(){for(const t of state.trees){if(t.stump&&state.day>=t.regrowDay){t.stump=false;t.hp=3;t.fruitCount=0;t.regrowDay=state.day+2}else if(!t.stump&&t.fruit!=='none'&&t.fruitCount===0&&treeMature(t)&&((t.regrowDay&&state.day>=t.regrowDay)||(!t.regrowDay&&t.plantedDay!=null)))t.fruitCount=3}for(const r of state.rocks)if(r.broken&&state.day>=r.respawnDay){r.broken=false;r.hp=3}for(const f of state.flowers)if(f.picked&&state.day>=f.respawnDay)f.picked=false;for(const p of state.plots){if(p.crop)p.watered=false}}
function cropDays(c){return c==='carrot'?2:c==='tomato'?3:4}function cropMature(p){return p.crop&&state.day-p.plantedDay>=cropDays(p.crop)}function treeAge(t){return t.plantedDay==null?99:Math.max(0,state.day-t.plantedDay)}function treeMature(t){return treeAge(t)>=3}function canPlantTreeAt(x,y){if(x<95||x>WORLD.w-95||y<95||y>WORLD.h-235)return{ok:false,msg:'Hier ist zu wenig Platz.'};for(const w of ponds)if(rectContains(w,x,y,55))return{ok:false,msg:'Zu nah am Wasser.'};for(const b of buildings)if(rectContains(b,x,y,80))return{ok:false,msg:'Zu nah an einem Gebäude.'};for(const p of paths)if(rectContains(p,x,y,38))return{ok:false,msg:'Nicht mitten auf den Weg pflanzen.'};for(const pl of state.plots)if(rectContains(pl,x,y,45))return{ok:false,msg:'Nicht auf dem Gemüsebeet.'};for(const t of state.trees)if(!t.stump&&dist(x,y,t.x,t.y)<105)return{ok:false,msg:'Zu nah an einem anderen Baum.'};for(const r of state.rocks)if(!r.broken&&dist(x,y,r.x,r.y)<75)return{ok:false,msg:'Zu nah an einem Stein.'};return{ok:true,msg:''}}function plantSapling(id){if((state.inventory[id]||0)<1){toast('Kein Setzling vorhanden.');return}const item=ITEMS[id],p=state.player,dx=p.dirX||0,dy=p.dirY||1,len=Math.hypot(dx,dy)||1,x=clamp(p.x+dx/len*92,80,WORLD.w-80),y=clamp(p.y+dy/len*92,80,WORLD.h-220),check=canPlantTreeAt(x,y);if(!check.ok){toast(check.msg);return}state.inventory[id]--;state.trees.push(tree(x,y,item.fruit,state.day));setOverlay('inventoryOverlay',false);toast(`${item.name} gepflanzt. Er wächst in etwa 3 Tagen.`);saveGame()}
function nearestInteriorInteractable(){const list=INTERIOR_ACTIONS[state.currentArea]||[];let best=null,bestD=9999;for(const o of list){const d=dist(state.player.x,state.player.y,o.x,o.y);if(d<o.r&&d<bestD){best={type:'interior',obj:o,d};bestD=d}}return best}
function nearestInteractable(){if(state.currentArea!=='world')return nearestInteriorInteractable();const p=state.player;let best=null,bestD=9999;for(const b of buildings){const doorX=b.x+b.w/2,doorY=b.y+b.h+26,d=dist(p.x,p.y,doorX,doorY);if(d<82&&d<bestD){best={type:b.id,obj:b,d};bestD=d}}for(const n of NPCS){const d=dist(p.x,p.y,n.x,n.y);if(d<80&&d<bestD){best={type:'npc',obj:n,d};bestD=d}}for(const t of state.trees){const d=dist(p.x,p.y,t.x,t.y);if(d<88&&d<bestD){best={type:'tree',obj:t,d};bestD=d}}for(const r of state.rocks){const d=dist(p.x,p.y,r.x,r.y);if(d<82&&d<bestD){best={type:'rock',obj:r,d};bestD=d}}for(const f of state.flowers){const d=dist(p.x,p.y,f.x,f.y);if(!f.picked&&d<65&&d<bestD){best={type:'flower',obj:f,d};bestD=d}}for(const pl of state.plots){const d=dist(p.x,p.y,pl.x+pl.w/2,pl.y+pl.h/2);if(d<75&&d<bestD){best={type:'plot',obj:pl,d};bestD=d}}for(const b of state.bugs){if(b.caught)continue;const d=dist(p.x,p.y,b.x,b.y);if(d<78&&d<bestD){best={type:'bug',obj:b,d};bestD=d}}return best}
function nearWater(){if(state.currentArea!=='world')return false;const p=state.player;for(const w of ponds){const cx=clamp(p.x,w.x,w.x+w.w),cy=clamp(p.y,w.y,w.y+w.h);if(dist(p.x,p.y,cx,cy)<95)return true}return p.y>WORLD.h-230}
function updateContextHint(){if(pausedByOverlay){UI.contextHint.style.display='none';return}if(fishing){UI.contextHint.textContent=fishing.ready?'E · Jetzt einholen!':'🎣 Warten auf einen Biss …';UI.contextHint.style.display='block';return}const n=nearestInteractable();let text='';if(n){if(n.type==='house')text='E · Haus betreten';else if(n.type==='shop')text='E · Laden betreten';else if(n.type==='museum')text='E · Museum betreten';else if(n.type==='craft')text='E · Werkstatt betreten';else if(n.type==='npc')text=`E · Mit ${n.obj.name} sprechen`;else if(n.type==='interior')text=`E · ${n.obj.label}`;else if(n.type==='tree')text=n.obj.stump?'Der Baum wächst nach':!treeMature(n.obj)?`🌱 Junger Baum · noch ${Math.max(1,3-treeAge(n.obj))} Tag(e)`:n.obj.fruitCount>0?'E · Obst ernten | F · Axt':'F · Axt benutzen';else if(n.type==='rock')text=n.obj.broken?'Geröll':'F · Spitzhacke';else if(n.type==='flower')text='E · Blume pflücken';else if(n.type==='bug')text='F · Kescher benutzen';else if(n.type==='plot')text=n.obj.crop?(cropMature(n.obj)?'E · Gemüse ernten':'E · Feld ansehen'):'E · Samen pflanzen'}else if(nearWater())text='F · Angel auswerfen';UI.contextHint.textContent=text;UI.contextHint.style.display=text?'block':'none'}
function handleInteriorAction(o){if(!o)return;switch(o.action){case'exit':leaveBuilding();break;case'sleep':newDay(true);state.player.x=330;state.player.y=330;saveGame(false);break;case'stove':stokeStove();break;case'save':saveGame(true,true);break;case'furnish':setOverlay('roomOverlay',true);break;case'houseMenu':setOverlay('houseOverlay',true);break;case'shop':setOverlay('shopOverlay',true);break;case'shelfSeeds':toast('🌱 Im Regal liegen Karotten-, Tomaten- und Kürbissamen. Kaufen kannst du an der Kasse.');break;case'shelfTools':toast('🪓 Axt, ⛏️ Spitzhacke, 🎣 Angel und 🦋 Kescher. Mika verkauft sie an der Kasse.');break;case'shelfTrees':toast('🌳 Hier stehen Laub-, Apfel-, Orangen- und Kirschbaum-Setzlinge.');break;case'museum':setOverlay('museumOverlay',true);break;case'fishExhibit':{const n=Object.values(state.donated.fish||{}).filter(Boolean).length;toast(n?`🐟 In der Fischhalle sind ${n} deiner gespendeten Arten ausgestellt.`:'🐟 Die Aquarien warten noch auf deine erste Fischspende.');break}case'bugExhibit':{const n=Object.values(state.donated.bugs||{}).filter(Boolean).length;toast(n?`🦋 In der Insektenhalle sind ${n} deiner gespendeten Arten ausgestellt.`:'🦋 Die Schaukästen sind noch leer. Zeit für den Kescher.');break}case'craft':setOverlay('craftOverlay',true);break;case'woodRack':toast(`🪵 Dein Holzvorrat: ${state.inventory.wood||0}`);break;case'stoneRack':toast(`🪨 Dein Steinvorrat: ${state.inventory.stone||0}`);break;case'talkBruno':{const bruno=NPCS.find(n=>n.name==='Bruno');if(bruno)openNpc(bruno);break}}}
function interact(){if(pausedByOverlay)return;if(fishing){if(fishing.ready)catchFish();else toast('Noch kein Biss. Geduld, diese biologische Zumutung.');return}const n=nearestInteractable();if(!n){toast('Hier gibt es gerade nichts zu tun.');return}if(n.type==='interior'){handleInteriorAction(n.obj);return}if(n.type==='house'){enterBuilding('house');return}if(n.type==='shop'){enterBuilding('shop');return}if(n.type==='museum'){enterBuilding('museum');return}if(n.type==='craft'){enterBuilding('craft');return}if(n.type==='npc'){openNpc(n.obj);return}if(n.type==='tree'){const t=n.obj;if(t.stump){toast('Der Baum wächst noch nach.');return}if(!treeMature(t)){toast(`Der junge Baum braucht noch ${Math.max(1,3-treeAge(t))} Tag(e), bis er ausgewachsen ist.`);return}if(t.fruitCount>0){addItem(t.fruit,t.fruitCount);state.questProgress.fruit+=t.fruitCount;toast(`+${t.fruitCount} ${ITEMS[t.fruit].name}`);t.fruitCount=0;t.regrowDay=state.day+2;saveGame(false);return}toast(t.fruit==='none'?'Ein kräftiger ausgewachsener Baum.':'Keine Früchte. Vielleicht in ein paar Tagen.');return}if(n.type==='flower'){n.obj.picked=true;n.obj.respawnDay=state.day+2;addItem('flower',1);toast('+1 Wildblume');saveGame(false);return}if(n.type==='plot'){handlePlot(n.obj);return}}
function handlePlot(p){if(!p.crop){const choices=[['carrotSeed','carrot'],['tomatoSeed','tomato'],['pumpkinSeed','pumpkin']];const found=choices.find(([seed])=>state.inventory[seed]>0);if(!found){toast('Du brauchst Saatgut aus dem Laden.');return}state.inventory[found[0]]--;p.crop=found[1];p.plantedDay=state.day;p.watered=true;toast(`${ITEMS[found[1]].name} gepflanzt.`);saveGame(false);return}if(cropMature(p)){const item=p.crop;addItem(item,randInt(2,3));toast(`${ITEMS[item].name} geerntet!`);p.crop=null;p.plantedDay=0;p.watered=false;saveGame(false)}else{p.watered=true;toast(`${ITEMS[p.crop].name}: noch ${Math.max(1,cropDays(p.crop)-(state.day-p.plantedDay))} Tag(e) bis zur Ernte.`);saveGame(false)}}
function useTool(){if(pausedByOverlay||fishing)return;if(state.currentArea!=='world'){toast('Drinnen brauchst du hier kein Werkzeug. Interagiere mit E bzw. Aktion.');return}const n=nearestInteractable();if(n&&n.type==='tree'){if(state.inventory.axe<1){toast('Du brauchst eine Axt.');return}if(n.obj.stump){toast('Der Baum ist bereits gefällt.');return}if(!treeMature(n.obj)){toast('Der Setzling ist noch zu jung zum Fällen. Lass ihn erst wachsen.');return}if(!spendEnergy(6))return;n.obj.hp--;if(n.obj.hp<=0){n.obj.stump=true;n.obj.regrowDay=state.day+3;const amount=randInt(3,5);addItem('wood',amount);state.questProgress.wood+=amount;toast(`Baum gefällt! +${amount} Holz`);saveGame(false)}else toast(`🪓 Treffer. Noch ${n.obj.hp}.`);return}if(n&&n.type==='rock'){if(state.inventory.pickaxe<1){toast('Du brauchst eine Spitzhacke.');return}if(n.obj.broken){toast('Nur noch Geröll.');return}if(!spendEnergy(5))return;n.obj.hp--;if(n.obj.hp<=0){n.obj.broken=true;n.obj.respawnDay=state.day+2;const amount=randInt(2,4);addItem('stone',amount);toast(`Stein abgebaut! +${amount} Stein`);saveGame(false)}else toast(`⛏️ Treffer. Noch ${n.obj.hp}.`);return}if(n&&n.type==='bug'){if(state.inventory.net<1){toast('Du brauchst einen Kescher.');return}if(!spendEnergy(2))return;const b=n.obj;b.caught=true;const id='bug_'+b.type;addItem(id,1);state.collection.bugs[b.type]=(state.collection.bugs[b.type]||0)+1;toast(`${BUGS[b.type].icon} ${BUGS[b.type].name} gefangen!`);saveGame(false);return}if(nearWater()){startFishing();return}toast('Hier bringt dein Werkzeug gerade nichts.')}
function startFishing(){if(state.inventory.rod<1){toast('Du brauchst eine Angel aus dem Laden.');return}if(!spendEnergy(3))return;fishing={timer:rand(1.2,3.4),ready:false,readyTimer:0};toast('Angel ausgeworfen …')}
function updateFishing(dt){if(!fishing)return;if(!fishing.ready){fishing.timer-=dt;if(fishing.timer<=0){fishing.ready=true;fishing.readyTimer=1.8;toast('Biss! Jetzt E drücken!')}}else{fishing.readyTimer-=dt;if(fishing.readyTimer<=0){fishing=null;toast('Der Fisch ist entwischt.')}}}
function catchFish(){if(!fishing||!fishing.ready)return;const r=Math.random();const type=r<.42?'minnow':r<.68?'carp':r<.86?'trout':r<.97?'eel':'goldfish';fishing=null;addItem('fish_'+type,1);state.collection.fish[type]=(state.collection.fish[type]||0)+1;state.questProgress.fish++;toast(`${FISH[type].icon} ${FISH[type].name} gefangen!`);saveGame(false)}
function openNpc(n){currentNpc=n;const lvl=state.friendship[n.name]||0;UI.npcName.textContent=`👋 ${n.name}`;UI.npcDialogue.textContent=n.talk[(state.day+Math.floor(lvl/10))%n.talk.length];UI.npcFriendship.textContent=`Freundschaft: ${lvl} / 100`;state.friendship[n.name]=Math.min(100,lvl+1);state.questProgress.talk++;setOverlay('npcOverlay',true)}
function giftFruit(){if(!currentNpc)return;const id=['apple','orange','cherry'].find(k=>state.inventory[k]>0);if(!id){toast('Du hast kein Obst zum Verschenken.');return}state.inventory[id]--;state.friendship[currentNpc.name]=Math.min(100,(state.friendship[currentNpc.name]||0)+8);UI.npcFriendship.textContent=`Freundschaft: ${state.friendship[currentNpc.name]} / 100`;toast(`${currentNpc.name} freut sich über das Geschenk.`);saveGame(false)}
function renderInventory(){UI.inventoryList.innerHTML='';const rows=[];for(const [id,item] of Object.entries(ITEMS))rows.push([id,item,state.inventory[id]||0]);for(const [id,item] of Object.entries(FISH))rows.push(['fish_'+id,{...item},state.inventory['fish_'+id]||0]);for(const [id,item] of Object.entries(BUGS))rows.push(['bug_'+id,{...item},state.inventory['bug_'+id]||0]);rows.filter(r=>r[2]>0||ITEMS[r[0]]?.type==='tool').forEach(([id,item,count])=>{const el=document.createElement('div');el.className='invItem';el.innerHTML=`<div style="font-size:25px">${item.icon}</div><strong>${item.name}</strong><div class="invCount">${count}</div>`;if(['apple','orange','cherry','carrot','tomato','pumpkin'].includes(id)&&count>0){const b=document.createElement('button');b.textContent='Essen';b.className='good';b.onclick=()=>eatFood(id);el.appendChild(b)}if(ITEMS[id]?.type==='sapling'&&count>0){const b=document.createElement('button');b.textContent='Pflanzen';b.className='good';b.onclick=()=>plantSapling(id);el.appendChild(b)}if(id==='energyDrink'&&count>0){const b=document.createElement('button');b.textContent='Trinken';b.onclick=()=>{state.inventory.energyDrink--;state.energy=Math.min(state.maxEnergy,state.energy+35);renderInventory();updateHud();toast('+35 Energie')};el.appendChild(b)}UI.inventoryList.appendChild(el)})}
function renderShop(){UI.shopBuy.innerHTML='';UI.shopSell.innerHTML='';['axe','pickaxe','rod','net','energyDrink','sapling','appleSapling','orangeSapling','cherrySapling','carrotSeed','tomatoSeed','pumpkinSeed'].forEach(id=>{const item=ITEMS[id],row=document.createElement('div');row.className='itemRow';row.innerHTML=`<div><strong>${item.icon} ${item.name}</strong><div class="meta">Besitz: ${state.inventory[id]||0}</div></div><div><div class="price">${item.buy} 🪙</div></div>`;const b=document.createElement('button');b.textContent='Kaufen';b.onclick=()=>buyItem(id);row.lastElementChild.appendChild(b);UI.shopBuy.appendChild(row)});const sellRows=[];['apple','orange','cherry','wood','stone','flower','carrot','tomato','pumpkin'].forEach(id=>sellRows.push([id,ITEMS[id]]));Object.entries(FISH).forEach(([id,item])=>sellRows.push(['fish_'+id,item]));Object.entries(BUGS).forEach(([id,item])=>sellRows.push(['bug_'+id,item]));sellRows.forEach(([id,item])=>{const count=state.inventory[id]||0,row=document.createElement('div');row.className='itemRow';row.innerHTML=`<div><strong>${item.icon} ${item.name}</strong><div class="meta">Im Inventar: ${count}</div></div><div><div class="price">${item.sell} 🪙</div></div>`;const b=document.createElement('button');b.textContent='1';b.disabled=count<1;b.onclick=()=>sellItem(id,1);const all=document.createElement('button');all.textContent='Alle';all.className='secondary';all.style.marginLeft='5px';all.disabled=count<1;all.onclick=()=>sellItem(id,state.inventory[id]);row.lastElementChild.append(b,all);UI.shopSell.appendChild(row)})}
function buyItem(id){const item=ITEMS[id];if(state.money<item.buy){toast('Nicht genug Münzen.');return}state.money-=item.buy;addItem(id,1);renderShop();updateHud();saveGame(false);toast(`${item.name} gekauft.`)}function sellItem(id,n){n=Math.min(n,state.inventory[id]||0);if(n<=0)return;let item=ITEMS[id];if(id.startsWith('fish_'))item=FISH[id.slice(5)];if(id.startsWith('bug_'))item=BUGS[id.slice(4)];state.inventory[id]-=n;state.money+=item.sell*n;renderShop();updateHud();saveGame(false);toast(`${n}× ${item.name} verkauft.`)}
function renderCraft(){UI.craftList.innerHTML='';for(const [id,r] of Object.entries(RECIPES)){const el=document.createElement('div');el.className='card';const costText=Object.entries(r.cost).map(([k,v])=>`${v} ${ITEMS[k].name}`).join(' · ');el.innerHTML=`<strong>${r.icon} ${r.name}</strong><p>${costText}</p>`;const b=document.createElement('button');b.textContent='Herstellen';b.onclick=()=>craft(id);el.appendChild(b);UI.craftList.appendChild(el)}}function craft(id){const r=RECIPES[id];for(const [k,v] of Object.entries(r.cost))if((state.inventory[k]||0)<v){toast('Dir fehlen Materialien.');return}for(const [k,v] of Object.entries(r.cost))state.inventory[k]-=v;addItem(id,1);renderCraft();saveGame(false);toast(`${r.name} hergestellt.`)}
function renderMuseum(){UI.museumList.innerHTML='';let donated=0,total=Object.keys(FISH).length+Object.keys(BUGS).length;for(const [id,item] of Object.entries(FISH)){const ok=!!state.donated.fish[id];if(ok)donated++;const el=document.createElement('div');el.className='invItem';el.innerHTML=`<div style="font-size:24px">${item.icon}</div><strong>${item.name}</strong><div class="meta">${item.rarity}</div><div>${ok?'✅ Ausgestellt':'⬜ Noch nicht gespendet'}</div>`;UI.museumList.appendChild(el)}for(const [id,item] of Object.entries(BUGS)){const ok=!!state.donated.bugs[id];if(ok)donated++;const el=document.createElement('div');el.className='invItem';el.innerHTML=`<div style="font-size:24px">${item.icon}</div><strong>${item.name}</strong><div class="meta">${item.rarity}</div><div>${ok?'✅ Ausgestellt':'⬜ Noch nicht gespendet'}</div>`;UI.museumList.appendChild(el)}UI.museumSummary.textContent=`Sammlung: ${donated} von ${total} Ausstellungsstücken.`}
function donateAll(){let n=0;for(const id of Object.keys(FISH)){if(!state.donated.fish[id]&&(state.inventory['fish_'+id]||0)>0){state.inventory['fish_'+id]--;state.donated.fish[id]=true;n++}}for(const id of Object.keys(BUGS)){if(!state.donated.bugs[id]&&(state.inventory['bug_'+id]||0)>0){state.inventory['bug_'+id]--;state.donated.bugs[id]=true;n++}}renderMuseum();saveGame(false);toast(n?`${n} neue Stücke gespendet.`:'Keine neuen Stücke zum Spenden.')}
function houseUpgradeCost(){return state.houseLevel===1?{money:2500,wood:20}:state.houseLevel===2?{money:6000,wood:40}:null}function renderHouse(){const c=houseUpgradeCost();UI.houseUpgradeInfo.textContent=c?`Hausstufe ${state.houseLevel}. Nächste Stufe: ${c.money.toLocaleString('de-DE')} Münzen + ${c.wood} Holz.`:`Hausstufe ${state.houseLevel}. In dieser Version vollständig ausgebaut.`;$('upgradeHouseBtn').disabled=!c;const hrs=state.stoveFuel/60;UI.stoveInfo.innerHTML=state.stoveFuel>0?`<span class="statusGood">🔥 Ofen brennt</span> · noch ca. ${hrs.toFixed(1)} Spielstunden.<br>Holz im Inventar: ${state.inventory.wood||0}`:`<span class="statusWarn">🧊 Ofen ist aus.</span><br>2 Holz ergeben etwa 8 Spielstunden Wärme. Im Winter ist ein warmer Ofen vor dem Schlafen wichtig.`;$('stokeStoveBtn').disabled=(state.inventory.wood||0)<2||state.stoveFuel>600;UI.sleepInfo.textContent=state.ateToday?'Du hast heute gegessen. Schlafen füllt deine Energie auf.':'Du hast heute noch nichts gegessen. Wenn du jetzt schläfst, startest du morgen erschöpft.';try{const meta=JSON.parse(localStorage.getItem(SAVE_META_KEY)||'null');if(UI.houseSaveStatus)UI.houseSaveStatus.textContent=meta&&meta.savedAt?`Zuletzt gespeichert: ${formatSaveTime(meta.savedAt)} · Tag ${meta.day}${meta.manual?' · manuell im Haus':''}`:'Noch kein manueller Haus-Spielstand gespeichert.'}catch(e){if(UI.houseSaveStatus)UI.houseSaveStatus.textContent='Speicherstatus konnte nicht gelesen werden.'}drawHousePreview()}
