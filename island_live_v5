function buildSaveSnapshot(){return JSON.parse(JSON.stringify({schemaVersion:5,day:state.day,minutes:state.minutes,weather:state.weather,money:state.money,energy:state.energy,maxEnergy:state.maxEnergy,hunger:state.hunger,ateToday:state.ateToday,stoveFuel:state.stoveFuel,houseLevel:state.houseLevel,currentArea:state.currentArea,lastWorldPos:state.lastWorldPos,inventory:state.inventory,collection:state.collection,donated:state.donated,friendship:state.friendship,questProgress:state.questProgress,questClaimed:state.questClaimed,roomPlaced:state.roomPlaced,player:state.player,trees:state.trees,rocks:state.rocks,flowers:state.flowers,plots:state.plots,bugs:state.bugs}))}
async function saveGame(notify=false,manual=false){
if(!gameStarted)return false;
const snapshot=buildSaveSnapshot(),payload=JSON.stringify(snapshot),meta={savedAt:Date.now(),day:state.day,minutes:state.minutes,size:payload.length,manual:!!manual,plantedTrees:snapshot.trees.filter(t=>t.plantedDay!=null&&!t.stump).length,activeCrops:snapshot.plots.filter(p=>p.crop).length};
let localOK=false,idbOK=false;
try{
const previous=localStorage.getItem(SAVE_KEY);
if(previous&&previous!==payload){try{localStorage.setItem(SAVE_BACKUP_KEY,previous)}catch(e){console.warn('Backup konnte nicht geschrieben werden:',e)}}
localStorage.setItem(SAVE_KEY,payload);
localStorage.setItem(SAVE_META_KEY,JSON.stringify(meta));
localOK=localStorage.getItem(SAVE_KEY)===payload;
}catch(e){console.warn('localStorage-Speichern fehlgeschlagen:',e)}
try{
idbSaveChain=idbSaveChain.then(async()=>{await saveToIndexedDB(payload,meta);const verify=await loadFromIndexedDB();return !!verify&&verify.payload===payload},async()=>{await saveToIndexedDB(payload,meta);const verify=await loadFromIndexedDB();return !!verify&&verify.payload===payload});
idbOK=await idbSaveChain;
}catch(e){console.warn('IndexedDB-Speichern fehlgeschlagen:',e)}
const ok=localOK||idbOK;
updateSaveStatus(meta,ok);
if(notify)toast(ok?`✅ Spielstand gespeichert${manual?' – Speicherstation im Haus bestätigt.':''}`:'❌ Speichern fehlgeschlagen. Bitte nicht im privaten Browsermodus spielen.');
return ok;
}

