function drawFlowers(){const colors=['#ffdb63','#ff8eb2','#fff6ff','#8dd9ff'];for(const f of state.flowers){if(f.picked)continue;ctx.strokeStyle='#3f7f48';ctx.lineWidth=3;ctx.beginPath();ctx.moveTo(f.x,f.y+12);ctx.lineTo(f.x,f.y-5);ctx.stroke();ctx.fillStyle=colors[f.c%colors.length];for(let a=0;a<5;a++){const ang=a*Math.PI*2/5;ctx.beginPath();ctx.arc(f.x+Math.cos(ang)*7,f.y-8+Math.sin(ang)*7,5,0,Math.PI*2);ctx.fill()}ctx.fillStyle='#efb03b';ctx.beginPath();ctx.arc(f.x,f.y-8,4,0,Math.PI*2);ctx.fill()}}
function drawBugs(){for(const b of state.bugs){if(b.caught)continue;ctx.save();ctx.translate(b.x,b.y+Math.sin(b.phase)*4);if(b.type==='beetle'){ctx.fillStyle='#3d4b35';ctx.beginPath();ctx.ellipse(0,0,6,9,0,0,Math.PI*2);ctx.fill()}else{ctx.fillStyle=b.type==='moth'?'#c8b8a5':b.type==='dragonfly'?'#77d7db':'#f6a3d0';ctx.globalAlpha=.9;ctx.beginPath();ctx.ellipse(-6,0,7,4,-.4,0,Math.PI*2);ctx.ellipse(6,0,7,4,.4,0,Math.PI*2);ctx.fill();ctx.globalAlpha=1;ctx.fillStyle='#4a4a3c';ctx.fillRect(-1,-5,2,10)}ctx.restore()}}
function drawNPCs(){for(const n of NPCS){ctx.save();ctx.translate(n.x,n.y);ctx.fillStyle='rgba(0,0,0,.18)';ctx.beginPath();ctx.ellipse(4,22,18,7,0,0,Math.PI*2);ctx.fill();ctx.strokeStyle='#3f4e55';ctx.lineWidth=7;ctx.lineCap='round';ctx.beginPath();ctx.moveTo(-6,10);ctx.lineTo(-8,24);ctx.moveTo(6,10);ctx.lineTo(8,24);ctx.stroke();ctx.fillStyle=n.color;roundRect(ctx,-14,-1,28,24,8,true,false);ctx.fillStyle='#f2b99d';ctx.beginPath();ctx.arc(0,-15,13,0,Math.PI*2);ctx.fill();ctx.fillStyle=n.hair;ctx.beginPath();ctx.arc(0,-20,13,Math.PI,Math.PI*2);ctx.fill();ctx.fillStyle='#243b46';ctx.beginPath();ctx.arc(-4,-15,1.7,0,Math.PI*2);ctx.arc(4,-15,1.7,0,Math.PI*2);ctx.fill();ctx.font='700 12px system-ui';ctx.textAlign='center';ctx.fillStyle='rgba(9,20,25,.75)';roundRect(ctx,-34,-48,68,20,8,true,false);ctx.fillStyle='#fff';ctx.fillText(n.name,0,-34);ctx.restore()}}
function drawPlayer(){const p=state.player,bob=Math.sin(p.walkT)*2,step=Math.sin(p.walkT)*3;ctx.save();ctx.translate(p.x,p.y+bob);ctx.fillStyle='rgba(0,0,0,.22)';ctx.beginPath();ctx.ellipse(5,24,21,8,0,0,Math.PI*2);ctx.fill();ctx.strokeStyle='#263b49';ctx.lineWidth=7;ctx.lineCap='round';ctx.beginPath();ctx.moveTo(-6,10);ctx.lineTo(-8-step*.25,25);ctx.moveTo(6,10);ctx.lineTo(8+step*.25,25);ctx.stroke();const shirt=ctx.createLinearGradient(-14,0,14,22);shirt.addColorStop(0,'#ffe06b');shirt.addColorStop(1,'#e7a93b');ctx.fillStyle=shirt;roundRect(ctx,-15,-1,30,25,8,true,false);ctx.fillStyle='#f2b89e';ctx.beginPath();ctx.arc(0,-15,14,0,Math.PI*2);ctx.fill();ctx.fillStyle='#263b50';ctx.beginPath();ctx.arc(0,-20,14,Math.PI,Math.PI*2);ctx.fill();ctx.beginPath();ctx.arc(-10,-20,6,Math.PI*.8,Math.PI*1.6);ctx.fill();ctx.fillStyle='#273e50';ctx.beginPath();ctx.arc(-4,-15,1.9,0,Math.PI*2);ctx.arc(4,-15,1.9,0,Math.PI*2);ctx.fill();ctx.strokeStyle='rgba(144,74,62,.75)';ctx.lineWidth=1.5;ctx.beginPath();ctx.arc(0,-10,4,.2,Math.PI-.2);ctx.stroke();if(fishing){ctx.strokeStyle='#6d4d35';ctx.lineWidth=3;ctx.beginPath();ctx.moveTo(11,-1);ctx.lineTo(42,-30);ctx.stroke();ctx.strokeStyle='#d9e8ed';ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(42,-30);ctx.quadraticCurveTo(60,0,75,15);ctx.stroke()}ctx.restore()}
function drawBorder(){ctx.strokeStyle='rgba(255,255,255,.13)';ctx.lineWidth=8;ctx.strokeRect(4,4,WORLD.w-8,WORLD.h-8)}
function drawWeatherFx(){const sw=innerWidth,sh=innerHeight,now=performance.now()/1000;if(state.weather!=='sunny'){ctx.fillStyle='rgba(18,31,40,.11)';ctx.fillRect(0,0,sw,sh)}if(state.weather==='rain'||state.weather==='storm'){ctx.strokeStyle=state.weather==='storm'?'rgba(205,228,255,.65)':'rgba(190,220,255,.45)';ctx.lineWidth=2;for(let i=0;i<95;i++){const x=(i*83+now*240)%(sw+120)-60,y=(i*137+now*520)%(sh+80)-40;ctx.beginPath();ctx.moveTo(x,y);ctx.lineTo(x-8,y+18);ctx.stroke()}}if(state.weather==='storm'&&Math.sin(now*1.7)>.987){ctx.fillStyle='rgba(255,255,255,.30)';ctx.fillRect(0,0,sw,sh)}}
function drawDayNightOverlay(){const h=state.minutes/60;let a=0;if(h<6)a=.5;else if(h<8)a=(8-h)/2*.26;else if(h>18)a=Math.min(.5,(h-18)/6*.5);if(a){ctx.fillStyle=`rgba(18,31,66,${a})`;ctx.fillRect(0,0,innerWidth,innerHeight);if(h>19||h<5){ctx.fillStyle='rgba(255,230,130,.32)';for(const b of buildings){const cam=getCamera(),sx=b.x+b.w/2-cam.x,sy=b.y+b.h-35-cam.y;if(sx>-50&&sy>-50&&sx<innerWidth+50&&sy<innerHeight+50){ctx.beginPath();ctx.arc(sx,sy,42,0,Math.PI*2);ctx.fill()}}}}}
function drawMap(){const mc=$('mapCanvas'),m=mc.getContext('2d'),sx=mc.width/WORLD.w,sy=mc.height/WORLD.h;m.clearRect(0,0,mc.width,mc.height);m.fillStyle=seasonPalette().grass;m.fillRect(0,0,mc.width,mc.height);m.fillStyle='#61c3dc';for(const p of ponds)m.fillRect(p.x*sx,p.y*sy,p.w*sx,p.h*sy);m.fillRect(0,(WORLD.h-110)*sy,mc.width,110*sy);m.fillStyle='#cdb98c';for(const p of paths)m.fillRect(p.x*sx,p.y*sy,p.w*sx,p.h*sy);for(const b of buildings){m.fillStyle=b.roof;m.fillRect(b.x*sx,b.y*sy,b.w*sx,b.h*sy)}for(const t of state.trees)if(!t.stump){m.fillStyle=treeMature(t)?'#2f8f4f':'#9bd56c';m.beginPath();m.arc(t.x*sx,t.y*sy,treeMature(t)?4:2.8,0,Math.PI*2);m.fill()}NPCS.forEach(n=>{m.fillStyle='#ffe08a';m.beginPath();m.arc(n.x*sx,n.y*sy,5,0,Math.PI*2);m.fill()});const mapPos=state.currentArea==='world'?state.player:(state.lastWorldPos||state.player);m.fillStyle='#fff';m.beginPath();m.arc(mapPos.x*sx,mapPos.y*sy,7,0,Math.PI*2);m.fill();m.strokeStyle='#20333b';m.lineWidth=2;m.stroke();m.fillStyle='rgba(20,40,45,.78)';m.font='700 13px system-ui';m.fillText('Dorf',1500*sx,920*sy);m.fillText('Großer See',3770*sx,390*sy);m.fillText('Ostwald',4450*sx,1700*sy);m.fillText('Südwald',2500*sx,3220*sy)}
let mobileVector={x:0,y:0},stickActive=false,stickId=null;const stickBase=$('stickBase'),stickKnob=$('stickKnob');function updateStick(clientX,clientY){const r=stickBase.getBoundingClientRect(),cx=r.left+r.width/2,cy=r.top+r.height/2;let dx=clientX-cx,dy=clientY-cy,max=40,len=Math.hypot(dx,dy)||1;if(len>max){dx=dx/len*max;dy=dy/len*max}stickKnob.style.transform=`translate(${dx}px,${dy}px)`;mobileVector={x:dx/max,y:dy/max}}stickBase.addEventListener('pointerdown',e=>{stickActive=true;stickId=e.pointerId;stickBase.setPointerCapture(e.pointerId);updateStick(e.clientX,e.clientY)});stickBase.addEventListener('pointermove',e=>{if(stickActive&&e.pointerId===stickId)updateStick(e.clientX,e.clientY)});function endStick(){stickActive=false;stickId=null;mobileVector={x:0,y:0};stickKnob.style.transform='translate(0,0)'}stickBase.addEventListener('pointerup',endStick);stickBase.addEventListener('pointercancel',endStick);$('mobileInteract').onclick=interact;$('mobileTool').onclick=useTool;$('mobileInv').onclick=()=>setOverlay('inventoryOverlay',true);
function loop(now){const dt=Math.min(.033,(now-lastTime)/1000);lastTime=now;update(dt);draw();requestAnimationFrame(loop)}
