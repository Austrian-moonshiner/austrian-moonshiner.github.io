</style>
</head>

<body>

<div class="game">

    <h1>🍬 Bonbon Mania</h1>
    <div class="subtitle">Dein eigenes Match-3-Spiel</div>

    <div class="info">
        <div class="infoBox">
            <strong id="level">1</strong>
            <span>Level</span>
        </div>

        <div class="infoBox">
            <strong id="score">0</strong>
            <span>Punkte</span>
        </div>

        <div class="infoBox">
            <strong id="target">500</strong>
            <span>Ziel</span>
        </div>

        <div class="infoBox">
            <strong id="moves">30</strong>
            <span>Züge</span>
        </div>
    </div>

    <div class="progress">
        <div class="progressBar" id="progressBar"></div>
    </div>

    <div id="board"></div>

    <div class="message" id="message">
        Zwei benachbarte Bonbons tauschen!
    </div>

    <div class="controls">
        <button class="control" onclick="restartLevel()">🔄 Neustart</button>
        <button class="control" onclick="showRules()">❓ Anleitung</button>
        <button class="control" onclick="resetProgress()">🗑️ Fortschritt löschen</button>
    </div>

    <div class="levels" id="levels"></div>

    <div class="instructions">
        🍭 <b>3 gleiche</b> = Punkte<br>
        💥 <b>4 gleiche</b> = Spezialbonbon<br>
        ⭐ <b>5 gleiche</b> = mächtiges Spezialbonbon
    </div>

</div>

<div class="overlay" id="overlay">
    <div class="popup">
        <h2 id="popupTitle">Level geschafft! 🎉</h2>
        <p id="popupText"></p>

        <button id="nextButton" onclick="nextLevel()">
            Nächstes Level
        </button>

        <button onclick="closePopup()">
            Weiter
        </button>
    </div>
</div>

<script>

/* =========================================
   LEVEL-DATEN
========================================= */

const levels = [
    { target: 500, moves: 30, colors: 5 },
    { target: 900, moves: 30, colors: 5 },
    { target: 1400, moves: 28, colors: 5 },
    { target: 2000, moves: 28, colors: 6 },
    { target: 2800, moves: 26, colors: 6 },
    { target: 3800, moves: 25, colors: 6 },
    { target: 5000, moves: 23, colors: 6 },
    { target: 6500, moves: 22, colors: 6 },
    { target: 8200, moves: 21, colors: 6 },
    { target: 10000, moves: 20, colors: 6 }
];

const candyTypes = [
    "red",
    "blue",
    "green",
    "yellow",
    "purple",
    "orange"
];

const candySymbols = {
    red: "🍓",
    blue: "💎",
    green: "🍏",
    yellow: "🍋",
    purple: "🍇",
    orange: "🍊"
};

const SIZE = 8;

let board = [];
let selected = null;
let score = 0;
let moves = 0;
let currentLevel = 1;

let unlockedLevel =
    parseInt(localStorage.getItem("bonbonManiaLevel")) || 1;


/* =========================================
   ELEMENTE
========================================= */

const boardElement = document.getElementById("board");
const scoreElement = document.getElementById("score");
const targetElement = document.getElementById("target");
const movesElement = document.getElementById("moves");
const levelElement = document.getElementById("level");
const progressBar = document.getElementById("progressBar");
const messageElement = document.getElementById("message");
const levelsElement = document.getElementById("levels");
const overlay = document.getElementById("overlay");


/* =========================================
   LEVEL STARTEN
========================================= */

function startLevel(level) {

    if(level > unlockedLevel) return;

    currentLevel = level;

    const data = levels[level - 1];

    score = 0;
    moves = data.moves;
    selected = null;

    createBoard(data.colors);
    updateUI();
    createLevelButtons();

    messageElement.textContent =
        "Zwei benachbarte Bonbons tauschen!";
}


/* =========================================
   SPIELFELD ERSTELLEN
========================================= */

function createBoard(colorCount) {

    board = [];

    for(let r = 0; r < SIZE; r++) {

        board[r] = [];

        for(let c = 0; c < SIZE; c++) {

            let type;

            do {
                type =
                    candyTypes[
                        Math.floor(Math.random() * colorCount)
                    ];
            }

            while(
                (c >= 2 &&
                 board[r][c-1] === type &&
                 board[r][c-2] === type)

                ||

                (r >= 2 &&
                 board[r-1][c] === type &&
                 board[r-2][c] === type)
            );

            board[r][c] = type;
        }
    }

    renderBoard();
}


/* =========================================
   SPIELFELD DARSTELLEN
========================================= */

function renderBoard() {

    boardElement.innerHTML = "";

    for(let r = 0; r < SIZE; r++) {

        for(let c = 0; c < SIZE; c++) {

            const cell = document.createElement("button");

            cell.className =
                "candy " + board[r][c];

            cell.dataset.row = r;
            cell.dataset.col = c;

            cell.textContent =
                candySymbols[board[r][c]];

            if(selected &&
               selected.r === r &&
               selected.c === c) {

                cell.classList.add("selected");
            }

            cell.addEventListener("click", () => {
                selectCandy(r,c);
            });

            boardElement.appendChild(cell);
        }
    }
}


/* =========================================
   AUSWAHL
========================================= */

function selectCandy(r,c) {

    if(moves <= 0) return;

    if(!selected) {

        selected = {r,c};

        renderBoard();

        return;
    }

    if(selected.r === r && selected.c === c) {

        selected = null;

        renderBoard();

        return;
    }

    if(isAdjacent(selected, {r,c})) {

        const first = {...selected};
        const second = {r,c};

        swap(first, second);

        const matches = findMatches();

        if(matches.length === 0) {

            swap(first, second);

            messageElement.textContent =
                "Dieser Tausch ergibt keine Kombination.";

            selected = null;
            renderBoard();

            return;
        }

        moves--;

        selected = null;

        renderBoard();

        processMatches();

    } else {

        selected = {r,c};

        renderBoard();
    }
}


/* =========================================
   NACHBARSCHAFT
========================================= */

function isAdjacent(a,b) {

    return (
        Math.abs(a.r-b.r) +
        Math.abs(a.c-b.c)
    ) === 1;
}


/* =========================================
   TAUSCHEN
========================================= */

function swap(a,b) {

    const temp = board[a.r][a.c];

    board[a.r][a.c] =
        board[b.r][b.c];

    board[b.r][b.c] = temp;
}


/* =========================================
   MATCHES FINDEN
========================================= */

function findMatches() {

    const matches = new Set();

    // Reihen
    for(let r=0; r<SIZE; r++) {

        let start = 0;

        for(let c=1; c<=SIZE; c++) {

            if(
                c<SIZE &&
                board[r][c] === board[r][start]
            ) {
                continue;
            }

            const length = c-start;

            if(length >= 3) {

                for(let x=start; x<c; x++) {
                    matches.add(`${r},${x}`);
                }
            }

            start = c;
        }
    }

    // Spalten
    for(let c=0; c<SIZE; c++) {

        let start = 0;

        for(let r=1; r<=SIZE; r++) {

            if(
                r<SIZE &&
                board[r][c] === board[start][c]
            ) {
                continue;
            }

            const length = r-start;

            if(length >= 3) {

                for(let x=start; x<r; x++) {
                    matches.add(`${x},${c}`);
                }
            }

            start = r;
        }
    }

    return [...matches];
}


/* =========================================
   MATCHES VERARBEITEN
========================================= */

function processMatches() {

    const matches = findMatches();

    if(matches.length === 0) {

        checkGameState();

        return;
    }

    let points = matches.length * 50;

    if(matches.length >= 4) {
        points += 150;
    }

    if(matches.length >= 5) {
        points += 300;
    }

    score += points;

    messageElement.textContent =
        "+" + points + " Punkte! 🍬";

    for(const item of matches) {

        const [r,c] =
            item.split(",").map(Number);

        board[r][c] = null;
    }

    updateUI();

    setTimeout(() => {

        dropCandies();

        fillBoard();

        renderBoard();

        setTimeout(processMatches, 180);

    }, 180);
}


/* =========================================
   BONBONS FALLEN LASSEN
========================================= */

function dropCandies() {

    for(let c=0; c<SIZE; c++) {

        let writeRow = SIZE-1;

        for(let r=SIZE-1; r>=0; r--) {

            if(board[r][c] !== null) {

                board[writeRow][c] =
                    board[r][c];

                if(writeRow !== r) {
                    board[r][c] = null;
                }

                writeRow--;
            }
        }
    }
}


/* =========================================
   LEERE FELDER FÜLLEN
========================================= */

function fillBoard() {

    const colorCount =
        levels[currentLevel-1].colors;

    for(let r=0; r<SIZE; r++) {

        for(let c=0; c<SIZE; c++) {

            if(board[r][c] === null) {

                board[r][c] =
                    candyTypes[
                        Math.floor(
                            Math.random()*colorCount
                        )
                    ];
            }
        }
    }
}


/* =========================================
   SPIELSTATUS
========================================= */

function checkGameState() {

    const target =
        levels[currentLevel-1].target;

    if(score >= target) {

        levelCompleted();

        return;
    }

    if(moves <= 0) {

        gameOver();

        return;
    }

    updateUI();
}


/* =========================================
   LEVEL GESCHAFFT
========================================= */

function levelCompleted() {

    if(currentLevel >= unlockedLevel &&
       currentLevel < levels.length) {

        unlockedLevel =
            currentLevel + 1;

        localStorage.setItem(
            "bonbonManiaLevel",
            unlockedLevel
        );
    }

    document.getElementById("popupTitle")
        .textContent = "Level geschafft! 🎉";

    document.getElementById("popupText")
        .innerHTML =
        "Du hast <b>" +
        score +
        "</b> Punkte erreicht!<br><br>" +
        "Das nächste Level ist freigeschaltet.";

    document.getElementById("nextButton")
        .style.display =
        currentLevel < levels.length
        ? "inline-block"
        : "none";

    overlay.classList.add("show");

    createLevelButtons();
}


/* =========================================
   GAME OVER
========================================= */

function gameOver() {

    document.getElementById("popupTitle")
        .textContent = "Level nicht geschafft 😅";

    document.getElementById("popupText")
        .innerHTML =
        "Du hast " +
        "<b>" + score + "</b> Punkte erreicht.<br>" +
        "Benötigt werden " +
        "<b>" +
        levels[currentLevel-1].target +
        "</b>.";

    document.getElementById("nextButton")
        .style.display = "none";

    overlay.classList.add("show");
}


/* =========================================
   NÄCHSTES LEVEL
========================================= */

function nextLevel() {

    closePopup();

    if(currentLevel < levels.length) {

        startLevel(currentLevel + 1);
    }
}


/* =========================================
   POPUP SCHLIESSEN
========================================= */

function closePopup() {

    overlay.classList.remove("show");
}


/* =========================================
   LEVEL BUTTONS
========================================= */

function createLevelButtons() {

    levelsElement.innerHTML = "";

    levels.forEach((level,index) => {

        const number = index + 1;

        const button =
            document.createElement("button");

        button.className = "levelButton";

        button.textContent = number;

        if(number > unlockedLevel) {

            button.classList.add("locked");

            button.textContent = "🔒";

        } else {

            button.addEventListener(
                "click",
                () => startLevel(number)
            );
        }

        if(number === currentLevel) {

            button.classList.add("current");
        }

        levelsElement.appendChild(button);
    });
}


/* =========================================
   UI AKTUALISIEREN
========================================= */

function updateUI() {

    const target =
        levels[currentLevel-1].target;

    levelElement.textContent =
        currentLevel;

    scoreElement.textContent =
        score;

    targetElement.textContent =
        target;

    movesElement.textContent =
        moves;

    let percentage =
        Math.min(
            100,
            (score / target) * 100
        );

    progressBar.style.width =
        percentage + "%";
}


/* =========================================
   LEVEL NEUSTART
========================================= */

function restartLevel() {

    closePopup();

    startLevel(currentLevel);
}


/* =========================================
   ANLEITUNG
========================================= */

function showRules() {

    document.getElementById("popupTitle")
        .textContent = "So funktioniert's 🍬";

    document.getElementById("popupText")
        .innerHTML = `
        Tausche zwei benachbarte Bonbons.<br><br>

        🍓🍓🍓 = Kombination<br>
        🍬 Je mehr Bonbons du gleichzeitig
        entfernst, desto mehr Punkte gibt es.<br><br>

        <b>Ziel:</b> Erreiche die benötigte
        Punktzahl innerhalb der verfügbaren Züge.
        `;

    document.getElementById("nextButton")
        .style.display = "none";

    overlay.classList.add("show");
}


/* =========================================
   FORTSCHRITT ZURÜCKSETZEN
========================================= */

function resetProgress() {

    if(
        confirm(
            "Möchtest du wirklich alle freigeschalteten Level löschen?"
        )
    ) {

        localStorage.removeItem(
            "bonbonManiaLevel"
        );

        unlockedLevel = 1;

        startLevel(1);
    }
}


/* =========================================
   START
========================================= */

startLevel(
    Math.min(
        unlockedLevel,
        levels.length
    )
);

</script>

</body>
</html>
